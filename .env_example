
DISCORD_TOKEN=your-discord-bot-token-here

CLIENT_ID=1121971648917159966
GUILD_ID=1013871528380727356
TEST_CHANNEL_ID=1013877364658274314
TUNEGAME_TEST_CHANNEL_ID=1437227878956798094
TUNEGAME_CLIP_DURATION_SECONDS=10
TUNEGAME_ROUND_SECONDS=60
TUNEGAME_TITLE_MATCH_PERCENT=95
TUNEGAME_MAX_PREP_RETRIES_PER_ROUND=3
TUNEGAME_SONGS_FILE_PATH=data/songs_4900.json

# Voice channel the bot joins to play tunes & TTS announcements.
TUNEGAME_VOICE_CHANNEL_ID=1013871528380727362

# When true (default), also attach the round mp3 to the chat embed so users
# without voice can still play. Set to false to skip the upload (voice only).
TUNEGAME_UPLOAD_CLIP=false

# Edge neural TTS announcer voice config (free, no API key).
# Voice options (verified live on the consumer endpoint):
#   en-US-AndrewNeural     - American male, warm/conversational (recommended default)
#   en-US-BrianNeural      - American male, warm
#   en-US-ChristopherNeural- American male, deeper
#   en-US-EricNeural       - American male
#   en-US-GuyNeural        - American male, classic announcer
#   en-US-RogerNeural      - American male
#   en-US-SteffanNeural    - American male
#   en-GB-RyanNeural       - British male, polished
#   en-GB-ThomasNeural     - British male
#   en-AU-WilliamMultilingualNeural - Australian male
#   en-CA-LiamNeural       - Canadian male
#   en-IE-ConnorNeural     - Irish male
# Female: en-US-AriaNeural, en-US-AvaNeural, en-US-EmmaNeural, en-US-JennyNeural,
#         en-US-MichelleNeural, en-GB-SoniaNeural, en-GB-LibbyNeural, en-AU-NatashaNeural
# To preview voices: `node test-tts.mjs --list` or `node test-tts.mjs --all "phrase"`
TUNEGAME_TTS_VOICE=en-US-AndrewNeural
# rate examples:  -10%, +0%, +10%, +25%
TUNEGAME_TTS_RATE=+10%
# pitch examples: -5Hz, +0Hz, +10Hz
TUNEGAME_TTS_PITCH=+0Hz
# volume examples: default, loud, x-loud, +6dB, +0%
TUNEGAME_TTS_VOLUME=+0%
# express-as style. NOTE: as of 2026 the free Edge consumer endpoint no longer
# accepts <mstts:express-as> styles for any voice — leave blank.
TUNEGAME_TTS_STYLE=

ANON_CHANNEL_ID=1466159703493972000
LOG_CHANNEL_ID=1342591939534524416


